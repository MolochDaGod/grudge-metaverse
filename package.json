{
  "name": "grudge-metaverse",
  "version": "1.0.0",
  "private": true,
  "description": "Grudge Studio Metaverse — 3D multiplayer game client",
  "author": "Racalvin The Pirate King",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "smoke": "node scripts/smoke-live.mjs",
    "fleet:probe": "node scripts/fleet-probe.mjs",
    "fleet:probe:json": "node scripts/fleet-probe.mjs --json",
    "fleet:rewrites": "node scripts/generate-vercel-rewrites.mjs",
    "fleet:rewrites:write": "node scripts/generate-vercel-rewrites.mjs --write",
    "fleet:ops:deploy": "npm --prefix workers/fleet-ops run deploy",
    "server:install": "npm --prefix server install",
    "server:dev": "npm --prefix server run dev",
    "server:build": "npm --prefix server run build",
    "server:start": "npm --prefix server start",
    "server:typecheck": "npm --prefix server run typecheck"
  },
  "dependencies": {
    "socket.io-client": "^4.8.3",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}