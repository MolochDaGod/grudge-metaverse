{
  "rewrites": [
    { "source": "/api/auth/me", "destination": "https://grudge-builder-production.up.railway.app/api/auth/me" },
    { "source": "/api/auth/verify", "destination": "https://grudge-builder-production.up.railway.app/api/auth/verify" },
    { "source": "/api/auth/session/exchange", "destination": "https://api.grudge-studio.com/api/auth/session/exchange" },
    { "source": "/api/auth/:path*", "destination": "https://id.grudge-studio.com/auth/:path*" },
    { "source": "/api/characters", "destination": "https://grudge-builder-production.up.railway.app/api/characters" },
    { "source": "/api/characters/:path*", "destination": "https://grudge-builder-production.up.railway.app/api/characters/:path*" },
    { "source": "/api/:path*", "destination": "https://api.grudge-studio.com/:path*" },
    { "source": "/assets-cdn/:path*", "destination": "https://assets.grudge-studio.com/:path*" },
    { "source": "/api/assets/:path*", "destination": "https://assets.grudge-studio.com/:path*" },
    { "source": "/game/:path*", "destination": "https://grudge-game.pages.dev/game/:path*" },
    {
      "source": "/test",
      "destination": "https://client.grudge-studio.com/island-3d?engine=legacy&mode=lobby&map=pirate-islands"
    },
    {
      "source": "/test/:path*",
      "destination": "https://client.grudge-studio.com/island-3d?engine=legacy&mode=lobby&map=pirate-islands"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}