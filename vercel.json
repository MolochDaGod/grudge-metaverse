{
  "rewrites": [
    { "source": "/api/auth/:path*", "destination": "https://id.grudge-studio.com/auth/:path*" },
    { "source": "/api/characters/:path*", "destination": "https://api.grudge-studio.com/api/characters/:path*" },
    { "source": "/api/characters", "destination": "https://api.grudge-studio.com/api/characters" },
    { "source": "/api/:path*", "destination": "https://api.grudge-studio.com/api/:path*" },
    { "source": "/assets-cdn/:path*", "destination": "https://assets.grudge-studio.com/:path*" },
    { "source": "/api/assets/:path*", "destination": "https://assets.grudge-studio.com/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, OPTIONS" }
      ]
    }
  ]
}