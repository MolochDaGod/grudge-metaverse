# Grudge Metaverse — game server config

# Server
PORT=8001
NODE_ENV=development

# Game loop (NotBlox-style)
GAME_TICKRATE=20           # ticks per second (20 = 50ms)
MAX_PLAYERS_PER_ISLAND=64
PLAYER_MOVE_RATE_LIMIT=30  # max player-move events per second per socket

# CORS — comma-separated list of allowed origins (leave * in dev)
ALLOWED_ORIGINS=*
# Example for prod:
# ALLOWED_ORIGINS=https://metaverse.grudge-studio.com,https://www.grudge-studio.com

# Auth — Grudge ID backend
GRUDGE_ID_URL=https://id.grudge-studio.com
ALLOW_GUEST_NO_TOKEN=true  # accept connections without a token (guest mode)
